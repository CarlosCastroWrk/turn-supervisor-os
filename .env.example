# Turn Supervisor OS — environment variables
# Copy to .env for local dev. NEVER commit .env. NEVER put server secrets in VITE_* vars.

# --- Safe to expose in the browser (VITE_* is baked into the client bundle) ---
# Supabase project URL and anon (public) key. The anon key is safe client-side
# ONLY because Row Level Security is enabled on every table (see supabase/migrations).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Feature flags (default off — the app must keep working local-only without them)
VITE_ENABLE_SYNC=false
VITE_ENABLE_AI=false
VITE_ENABLE_VOICE=false

# --- Server-side ONLY (Vercel Functions) ---
# Set these in the Vercel dashboard, never in client code or a VITE_* variable.
OPENAI_API_KEY=replace-with-server-only-key
OPENAI_CAPTURE_FAST_MODEL=gpt-5.4-nano
OPENAI_CAPTURE_COMPLEX_MODEL=gpt-5.4-mini
# Optional emergency override. When set, every Capture request uses this model.
# OPENAI_MODEL=gpt-5.5
TURN_OS_ALLOWED_EMAIL=your-allowed-email@example.com

# The protected route reuses the public Supabase URL/anon key above to verify
# Los's bearer token. It does not need or accept a service-role key.
