{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": [
    "api/**/*.ts",
    "server/**/*.ts",
    "src/types.ts",
    "src/lib/constants.ts",
    "src/lib/ai/types.ts",
    "src/lib/ai/modelCapture.ts",
    "src/lib/ai/usage.ts",
    "src/features/turn-intelligence/contracts.ts",
    "src/features/turn-intelligence/mockProvider.ts",
    "src/features/turn-intelligence/promptSecurity.ts",
    "src/features/turn-intelligence/proposals.ts",
    "src/features/turn-intelligence/provider.ts",
    "src/features/turn-intelligence/router.ts",
    "src/features/turn-intelligence/service.ts",
    "src/features/turn-intelligence/tools.ts"
  ]
}
